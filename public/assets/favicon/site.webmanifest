{
  "name": "Meal05",
  "short_name": "Meal05",
  "description": "Farm-fresh groceries delivered in Ibadan.",
  "id": "/?source=pwa",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "background_color": "#ffffff",
  "theme_color": "#f04e1f",
  "orientation": "portrait",
  "categories": ["food", "shopping", "lifestyle"],
  "icons": [
    {
      "src": "/assets/favicon/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/favicon/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/favicon/android-maskable-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/assets/favicon/android-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/assets/favicon/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/favicon/favicon-48x48.png",
      "sizes": "48x48",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Shop groceries",
      "short_name": "Shop",
      "url": "/shop",
      "icons": [{ "src": "/assets/favicon/android-maskable-192x192.png", "sizes": "192x192", "purpose": "maskable" }]
    },
    {
      "name": "View cart",
      "short_name": "Cart",
      "url": "/cart",
      "icons": [{ "src": "/assets/favicon/android-maskable-192x192.png", "sizes": "192x192", "purpose": "maskable" }]
    }
  ]
}
