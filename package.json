{
    "name": "meal05-web",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "dev": "next dev",
        "dev:fresh": "node scripts/clean-next-cache.mjs && next dev",
        "build": "next build",
        "start": "next start",
        "lint": "node --max-old-space-size=4096 ./node_modules/eslint/bin/eslint.js --cache",
        "test": "node --test",
        "build:worker": "opennextjs-cloudflare build",
        "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
        "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
        "perf:search:db": "node scripts/measure-search-db.mjs",
        "perf:search:page": "node scripts/measure-search-page.mjs",
        "perf:search:browser": "node scripts/measure-search-browser.mjs",
        "images:backfill": "node scripts/backfill-product-image-variants.mjs",
        "images:import": "node scripts/import-product-images.mjs",
        "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
        "cf:waf:wp-probes": "node scripts/configure-cloudflare-waf.mjs"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "^7.2.0",
        "@supabase/ssr": "^0.5.0",
        "@supabase/supabase-js": "^2.76.0",
        "@tabler/icons-react": "^3.44.0",
        "@upstash/ratelimit": "^1.1.4",
        "@upstash/redis": "^1.33.0",
        "axios": "^1.13.5",
        "dotenv": "^17.2.3",
        "leaflet": "^1.9.4",
        "next": "^15.5.12",
        "node-rsa": "^1.1.1",
        "nodemailer": "^8.0.1",
        "pg": "^8.16.3",
        "react": "19.1.0",
        "react-dom": "19.1.0",
        "zod": "^4.1.12"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3",
        "@opennextjs/cloudflare": "^1.20.1",
        "@playwright/test": "^1.61.0",
        "autoprefixer": "^10.4.20",
        "eslint": "^9",
        "eslint-config-next": "^15.5.12",
        "postcss": "^8.4.49",
        "sharp": "^0.34.5",
        "tailwindcss": "^3.4.17",
        "wrangler": "^4.127.1"
    }
}
